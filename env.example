# ============================================
# POLLS APP - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and replace with your actual values
# Get these from: https://app.supabase.com/project/_/settings/api

# Supabase Project URL
# Found in: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase Anon/Public Key
# Found in: Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5emNvbXBhbnkiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYyMzg4MDAwMCwiZXhwIjoxOTM5NDU2MDAwfQ.mock-anon-key-replace-with-real-one

# Supabase Service Role Key (KEEP SECRET - SERVER ONLY)
# Found in: Project Settings > API > Project API keys > service_role
# Used by Edge Functions only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5emNvbXBhbnkiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjIzODgwMDAwLCJleHAiOjE5Mzk0NTYwMDB9.mock-service-role-key-replace-with-real-one

# ============================================
# SETUP INSTRUCTIONS:
# ============================================
# 1. Go to https://supabase.com and create a project
# 2. Wait for setup to complete (~2 minutes)
# 3. Go to Project Settings (gear icon) > API
# 4. Copy your Project URL and API keys
# 5. Run: cp env.example .env.local
# 6. Edit .env.local with your real values
# 7. Never commit .env.local to git (it's in .gitignore)

